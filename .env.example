# ---------------------------------------------------------------------------
# Greenshades Event Scanner — environment variables
# Copy to `.env.local` for local dev, or set these in the Vercel dashboard.
# NEVER commit real values. All keys are read server-side only.
# ---------------------------------------------------------------------------

# --- OCR (Anthropic vision) -------------------------------------------------
# Required for real OCR. Without it, /api/ocr returns a mock result so the UI
# still works end-to-end for a Vercel preview deploy.
ANTHROPIC_API_KEY=

# Model used to read badges. Defaults to claude-opus-5.
# For high-volume trade-show scanning you may prefer a faster/cheaper tier,
# e.g. claude-sonnet-5 or claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5

# --- Clay -------------------------------------------------------------------
# A Clay "webhook" source URL. Every reviewed contact is POSTed here. Clay owns
# the rest of the pipeline: enrich the sparse badge data, look the person up in
# HubSpot, then update or create the contact (upsert).
#
# The HubSpot credentials live in Clay's HubSpot integration, NOT here.
CLAY_WEBHOOK_URL=
